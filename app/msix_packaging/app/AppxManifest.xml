<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX 包清单（目录打包方式）
  元素顺序严格遵循微软官方模板，makeappx 对顺序敏感，请勿调整。
  ★ 发布者名称(Publisher)必须与签名证书的 Subject 完全一致 ★
  若你的证书是 CN=你的名字，请同步修改下方 Publisher 属性。
  包名 Name 只能包含字母/数字/点/连字符，3-50 字符，不能有空格。
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 rescap">

  <!-- 身份：包名 / 发布者（=证书 Subject）/ 版本(Major.Minor.Build.Revision) -->
  <Identity Name="samstay.OfficeSensitiveEncryptor"
            Publisher="CN=Sam Li"
            Version="2.4.0.0" />

  <Properties>
    <DisplayName>Office敏感词加解密工具</DisplayName>
    <PublisherDisplayName>Sam Li</PublisherDisplayName>
    <Description>Office 文档（Word/Excel/PPT）敏感词替换加密工具</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="zh-CN" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- 桌面（全信任）应用能力：exe 正常运行必需 -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

  <Applications>
    <!-- 入口 exe：相对包根目录；EntryPoint 固定为 Windows.FullTrustApplication -->
    <Application Id="OfficeSensitiveEncryptor"
                 Executable="OfficeSensitiveEncryptor.exe"
                 EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Office敏感词加解密工具"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png"
                          Description="Office 文档（Word/Excel/PPT）敏感词替换加密工具"
                          BackgroundColor="transparent" />
      <!-- 应用执行别名：为当前用户生成
           %LOCALAPPDATA%\Microsoft\WindowsApps\OfficeSensitiveEncryptor.exe。
           MSIX 下 exe 本体位于 WindowsApps 受限目录，普通用户进程不能直接
           执行该路径；桌面快捷方式（程序首启自动创建）即指向本别名，
           双击可正常启动，且 MSIX 升级后别名路径稳定不变。 -->
      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias">
          <uap3:AppExecutionAlias>
            <uap3:ExecutionAlias Alias="OfficeSensitiveEncryptor.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

</Package>
