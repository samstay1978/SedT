# ===== 代码签名证书（含私钥，绝不能上传）=====
*.pfx
*.cer
*.p12
*.key

# ===== Python / PyInstaller 构建中间产物 =====
app/build/
__pycache__/
*.py[cod]

# ===== 打包产物（exe / MSIX 由构建流水线生成，不入仓库）=====
app/msix_packaging/app/OfficeSensitiveEncryptor.exe
app/msix_packaging/dist_msix/
*.msix
*.exe

# build.bat 第8步生成的 ZIP 安装包（含临时 staging 目录）
app/dist_zip/

# 程序运行/打包时自动释放的说明书副本（由内嵌内容生成，非源文件）
app/README.txt
app/LICENSE.txt
app/msix_packaging/app/README.txt
app/msix_packaging/app/LICENSE.txt

# build.bat 第5步复制生成的 word 资源副本（源文件在 app/word/）
app/msix_packaging/app/word/

# ===== 其它 =====
*.zip
